    {
      "name": "2. Валідація схеми",
      "description": "Кожна відповідь звіряється зі схемою з контракту. Схема обирається за статус-кодом. Схеми — у змінних колекції schemaEvents, schemaSeats, schemaBooking, schemaError.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Які схеми для яких статус-кодів описані в контракті (openapi.yaml)",
              "const CONTRACT = {",
              "    'GET /events':              { 200: 'schemaEvents' },",
              "    'GET /events/{id}/seats':   { 200: 'schemaSeats', 400: 'schemaError', 404: 'schemaError' },",
              "    'POST /bookings':           { 200: 'schemaBooking', 400: 'schemaError', 404: 'schemaError', 409: 'schemaError' }",
              "};",
              "",
              "const path = pm.request.url.getPath().replace(/\\/\\d+(?=\\/|$)/g, '/{id}');",
              "const endpoint = pm.request.method + ' ' + path;",
              "const status = pm.response.code;",
              "",
              "pm.test(endpoint + ' → ' + status + ' відповідає контракту', function () {",
              "    const schemaName = (CONTRACT[endpoint] || {})[status];",
              "    if (!schemaName) {",
              "        throw new Error('статус ' + status + ' не описаний у контракті');",
              "    }",
              "    const schema = JSON.parse(pm.collectionVariables.get(schemaName));",
              "    const body = pm.response.json();",
              "",
              "    const Ajv = require('ajv');",
              "    const ajv = new Ajv({ allErrors: true, strict: false, logger: false });",
              "    if (ajv.validate(schema, body)) {",
              "        return;",
              "    }",
              "",
              "    // Читабельне повідомлення: «шлях: має бути X, прийшло Y»",
              "    const lines = ajv.errors.map(function (e) {",
              "        // ajv 6 дає dataPath \".status\" / \"[1].venue\", ajv 8 — instancePath \"/1/venue\"",
              "        let field = e.dataPath !== undefined",
              "            ? e.dataPath",
              "            : e.instancePath.replace(/\\/(\\d+)/g, '[$1]').replace(/\\//g, '.');",
              "        field = field.replace(/^\\./, '');",
              "        const value = field.split(/\\.|\\[|\\]/).filter(Boolean)",
              "            .reduce(function (obj, key) { return obj == null ? obj : obj[key]; }, body);",
              "        const shown = JSON.stringify(value);",
              "        if (e.keyword === 'type') {",
              "            return (field || '(корінь)') + ': має бути ' + e.params.type + ', прийшло ' + shown;",
              "        }",
              "        if (e.keyword === 'enum') {",
              "            return field + ': має бути одне з ' + e.params.allowedValues.join(' / ') + ', прийшло ' + shown;",
              "        }",
              "        if (e.keyword === 'required') {",
              "            return (field ? field + '.' : '') + e.params.missingProperty + ': обовʼязкове поле відсутнє';",
              "        }",
              "        return (field || '(корінь)') + ': ' + e.message;",
              "    });",
              "",
              "    const MAX = 3;  // щоб влазило на слайд",
              "    let message = lines.slice(0, MAX).join('\\n');",
              "    if (lines.length > MAX) {",
              "        message += '\\n... і ще ' + (lines.length - MAX) + ' таких самих';",
              "    }",
              "    throw new Error(message);",
              "});"
            ]
          }
        }
      ],
